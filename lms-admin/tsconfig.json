{
  "compilerOptions": {
    "target": "ES2022",
    "module": "Node16",
    "moduleResolution": "Node16",

    "resolveJsonModule": true,
    "esModuleInterop": true,

    "strict": true,
    "types": [
      "node",
      "@playwright/test"
    ],

    "skipLibCheck": true,
    "noEmit": true
  },

  "include": [
    "modules/**/*.ts",
    "tests/**/*.ts",
    "playwright.config.ts"
  ]
}